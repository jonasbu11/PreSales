{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          { "type": "command", "command": "sh -c 'python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" pre 2>/dev/null || true'", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "sh -c 'python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" prompt 2>/dev/null || true'", "timeout": 5 }
        ]
      }
    ]
  }
}
